# Production Environment Variables Template
# Copy these to your Railway environment variables

# Django Settings
SECRET_KEY=your-super-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=.railway.app,.vercel.app,localhost,127.0.0.1

# Database - Supabase PostgreSQL
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# CORS Settings
CORS_ALLOWED_ORIGINS=https://hisabpro.vercel.app,http://localhost:3000

# Email Settings (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=nikhilbajantri86@gmail.com
EMAIL_HOST_PASSWORD=efleuomllopzfcja
DEFAULT_FROM_EMAIL=nikhilbajantri86@gmail.com

# Razorpay Settings
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Redis (Railway will provide this)
# REDIS_URL=redis://localhost:6379/0

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key

# PDF Generation
USE_PLAYWRIGHT_PDF=True
USE_WEASYPRINT_PDF=True
USE_REPORTLAB_PDF=True
